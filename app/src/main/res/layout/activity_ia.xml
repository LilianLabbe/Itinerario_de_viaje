<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla"
    android:fillViewport="true"
    tools:context=".IaActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTituloIa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/titulo_ia"
            android:textColor="@color/texto_principal"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPromptIa"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginBottom="16dp"
            android:gravity="top|start"
            android:hint="@string/hint_prompt_ia"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_secundario" />

        <Button
            android:id="@+id/btnPreguntarIa"
            style="@style/EstiloBotonViaje"
            android:layout_marginBottom="24dp"
            android:text="@string/btn_preguntar_ia" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/fondo_tarjeta"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvRespuestaIa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="@string/respuesta_ejemplo_ia"
                android:textColor="@color/texto_principal"
                android:textSize="15sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>