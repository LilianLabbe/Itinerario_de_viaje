<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla"
    android:fillViewport="true"
    tools:context=".AgregarActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTituloAgregar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/titulo_agregar"
            android:textColor="@color/texto_principal"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDestinoAgregar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:autofillHints="postalAddress"
            android:hint="@string/hint_destino"
            android:inputType="textCapWords"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_secundario" />

        <EditText
            android:id="@+id/etFechasAgregar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:importantForAutofill="no"
            android:hint="@string/hint_fechas"
            android:inputType="text"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_secundario" />

        <EditText
            android:id="@+id/etPresupuestoAgregar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:importantForAutofill="no"
            android:hint="@string/hint_presupuesto"
            android:inputType="number"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_secundario" />

        <EditText
            android:id="@+id/etNotasAgregar"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="24dp"
            android:gravity="top|start"
            android:importantForAutofill="no"
            android:hint="@string/hint_notas"
            android:inputType="textMultiLine"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_secundario" />

        <Button
            android:id="@+id/btnGuardarViaje"
            style="@style/EstiloBotonViaje"
            android:text="@string/btn_guardar_viaje" />

    </LinearLayout>
</ScrollView>