<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla"
    android:fillViewport="true"
    tools:context=".RegistroActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTituloRegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/titulo_registro"
            android:textColor="@color/texto_principal"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNombreRegistro"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:autofillHints="name"
            android:hint="@string/hint_nombre"
            android:inputType="textPersonName"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_secundario" />

        <EditText
            android:id="@+id/etPaisRegistro"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:autofillHints="postalAddress"
            android:hint="@string/hint_pais_origen"
            android:inputType="text"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_secundario" />

        <EditText
            android:id="@+id/etCorreoRegistro"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:autofillHints="emailAddress"
            android:hint="@string/hint_correo"
            android:inputType="textEmailAddress"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_secundario" />

        <EditText
            android:id="@+id/etContrasenaRegistro"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:autofillHints="password"
            android:hint="@string/hint_contrasena"
            android:inputType="textPassword"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_secundario" />

        <EditText
            android:id="@+id/etRepetirContrasena"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            android:autofillHints="password"
            android:hint="@string/hint_repetir_contrasena"
            android:inputType="textPassword"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_secundario" />

        <TextView
            android:id="@+id/tvPreguntaTipoViaje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/pregunta_tipo_viaje"
            android:textColor="@color/texto_principal"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgTipoViaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbPlaya"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/rb_playa"
                android:textColor="@color/texto_principal" />

            <RadioButton
                android:id="@+id/rbAventura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rb_aventura"
                android:textColor="@color/texto_principal" />

            <RadioButton
                android:id="@+id/rbCiudad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rb_ciudad"
                android:textColor="@color/texto_principal" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/chkTerminos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/chk_terminos"
            android:textColor="@color/texto_principal" />

        <Button
            android:id="@+id/btnRegistrar"
            style="@style/EstiloBotonViaje"
            android:text="@string/btn_registrar" />

    </LinearLayout>
</ScrollView>